<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\prereqqer-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Info.plist" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/prereqqer-icon.icns" TargetPath="prereqqer-icon.icns" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" PrivateAssets="All" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prereqqer.Core\Prereqqer.Core.csproj" />
  </ItemGroup>

  <Target Name="CreateMacOSRunAppBundle" BeforeTargets="ComputeRunArguments" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <MacOSRunBundleDir>$(BaseIntermediateOutputPath)macos-run/Prereqqer.app</MacOSRunBundleDir>
      <RunCommand>open</RunCommand>
      <RunArguments>-n -W &quot;$(MSBuildProjectDirectory)/$(MacOSRunBundleDir)&quot; --args $(StartArguments)</RunArguments>
      <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    </PropertyGroup>
    <Exec Command="&quot;$(MSBuildProjectDirectory)/../../scripts/create-macos-app-bundle.sh&quot; &quot;$(TargetDir)&quot; &quot;$(MSBuildProjectDirectory)/$(MacOSRunBundleDir)&quot;" />
  </Target>
</Project>
